# Copy to .env in the repository root. Never commit real credentials.
# Independently read the manually opened BOSS results page in a dedicated Chrome.
CHROME_CDP_URL=http://127.0.0.1:9222
# 初始每日读取次数；前端保存的本地设置优先，不会清空已用计数。
COLLECTOR_DAILY_LIMIT=20
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8200
# Relative SQLite paths are resolved from the repository root by the launcher.
# Reserved for Phase 2; search tasks currently use local JSON snapshots.
DATABASE_URL=sqlite:///./data/jobpilot.db

# Model configuration defaults; saved local settings take precedence.
# Resume parsing uses these credentials on explicit request. Never use VITE_* for secrets.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
